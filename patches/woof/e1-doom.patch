 //
 // D_PageTicker
@@ -444,6 +449,42 @@ static demoloop_t demoloop_point;
 //
 void D_PageTicker(void)
 {
+#ifdef E1_CAMERA
+  // Presentation is intentionally capped to the camera stream rate, which can
+  // make page tics advance below 35 Hz.  Keep the first TITLEPIC dwell close to
+  // real wall time and do not start it while Doom is hidden behind the camera
+  // or entering through the external OSG melt.
+  if (demosequence == 0 && demoloop_point != NULL &&
+      demoloop_point->type == TYPE_ART)
+    {
+      uint64_t now;
+
+      if (!I_E1DemoTimerActive())
+        {
+          e1_title_visible_start_us = 0;
+          return;
+        }
+      now = I_GetTimeUS();
+      if (e1_title_visible_start_us == 0)
+        {
+          e1_title_visible_start_us = now;
+          I_Printf(VB_INFO, "E1_TITLE visible-start");
+          return;
+        }
+      if (now - e1_title_visible_start_us < E1_TITLE_DWELL_US)
+        return;
+      if (!singledemo)
+        {
+          I_Printf(VB_INFO, "E1_TITLE demo-advance elapsed_ms=%llu",
+                   (unsigned long long)
+                     ((now - e1_title_visible_start_us) / UINT64_C(1000)));
+          e1_title_visible_start_us = 0;
+          D_AdvanceDemo();
+        }
+      return;
+    }
+#endif
+
   // killough 12/98: don't advance internal demos if a single one is 
   // being played. The only time this matters is when using -loadgame with
   // -fastdemo, -playdemo, or -timedemo, and a consistency error occurs.
