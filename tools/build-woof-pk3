#!/usr/bin/env python3
"""Build Woof's data archive with stable order, metadata, and timestamps."""

from __future__ import annotations

from pathlib import Path
import stat
import sys
import zipfile


def main() -> int:
    if len(sys.argv) != 3:
        print(f"usage: {sys.argv[0]} WOOF_BASE OUTPUT", file=sys.stderr)
        return 2

    base = Path(sys.argv[1])
    output = Path(sys.argv[2])
    inputs = sorted(
        path
        for root in (base / "all-all", base / "doom-all")
        for path in root.rglob("*")
        if path.is_file()
    )
    if not inputs:
        print(f"no Woof data files below {base}", file=sys.stderr)
        return 1

    temporary = output.with_suffix(output.suffix + ".tmp")
    with zipfile.ZipFile(
        temporary, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9
    ) as archive:
        for path in inputs:
            name = path.relative_to(base).as_posix()
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.create_system = 3
            info.compress_type = zipfile.ZIP_DEFLATED
            mode = stat.S_IFREG | (path.stat().st_mode & 0o777)
            info.external_attr = mode << 16
            archive.writestr(info, path.read_bytes(), compresslevel=9)
    temporary.replace(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
