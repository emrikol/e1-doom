#!/bin/sh
set -eu

tool_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH='' cd -- "$tool_dir/.." && pwd)
state_dir=${E1_DOOM_HOST_STATE:-"$project_dir/.state"}
port=${E1_DOOM_SSH_PORT:-22222}
resolver="$tool_dir/e1-resolve"
known_hosts=${E1_DOOM_KNOWN_HOSTS:-"$state_dir/e1_camera_known_hosts"}

/bin/mkdir -p "$state_dir"
host=$("$resolver")

case ${1-} in
    put)
        test "$#" -eq 3
        source_path=$2
        destination_path=$3
        direction="$source_path root@$host:$destination_path"
        ;;
    get)
        test "$#" -eq 3
        source_path=$2
        destination_path=$3
        direction="root@$host:$source_path $destination_path"
        ;;
    *)
        echo "usage: $0 put LOCAL REMOTE | get REMOTE LOCAL" >&2
        exit 2
        ;;
esac

# Word splitting is intentional for the two already validated path operands.
# Project paths must not contain whitespace.
# shellcheck disable=SC2086
exec /usr/bin/scp -O \
    -P "$port" \
    -o HostKeyAlias=e1-doom-camera \
    -o ForwardAgent=no \
    -o PreferredAuthentications=none \
    -o PubkeyAuthentication=no \
    -o PasswordAuthentication=no \
    -o KbdInteractiveAuthentication=no \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$known_hosts" \
    -o ConnectTimeout=5 \
    -o ConnectionAttempts=1 \
    -o ServerAliveInterval=3 \
    -o ServerAliveCountMax=2 \
    $direction
